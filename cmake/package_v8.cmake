# GN 的 complete_static_lib 不包含隐式 Rust rlib；在原产物外生成完整嵌入库。
cmake_minimum_required(VERSION 3.25)

# GN 构建边的路径使用 Ninja 转义，不能用 shell 参数拆分规则。
# 先按未转义的空格/制表符拆分，再解码每个字面路径。
function(_engine_v8_parse_ninja_paths _text _output)
    string(REGEX REPLACE "\\$[ $:]" "" _unescaped "${_text}")
    if(_unescaped MATCHES "\\$")
        message(FATAL_ERROR "Unsupported variable or escape in GN archive paths: ${_text}")
    endif()
    string(REGEX MATCHALL "(\\$[ $:]|[^ \t$])+" _escaped_paths "${_text}")
    set(_paths)
    foreach(_path IN LISTS _escaped_paths)
        # 最后还原美元符号，避免把字面 $ 再当作转义前缀。
        string(REPLACE "$ " " " _path "${_path}")
        string(REPLACE "$:" ":" _path "${_path}")
        string(REPLACE "$$" "$" _path "${_path}")
        list(APPEND _paths "${_path}")
    endforeach()
    set(${_output} "${_paths}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED ENGINE_V8_OUTPUT)
    message(FATAL_ERROR "Missing ENGINE_V8_OUTPUT")
endif()
# 宿主只决定工具如何运行；归档格式和架构必须跟随 V8 的实际目标。
if(DEFINED ENGINE_V8_TARGET_OS AND NOT ENGINE_V8_TARGET_OS STREQUAL "")
    set(_target_os "${ENGINE_V8_TARGET_OS}")
elseif(CMAKE_HOST_WIN32)
    set(_target_os win)
elseif(CMAKE_HOST_APPLE)
    set(_target_os mac)
else()
    set(_target_os linux)
endif()
if(NOT _target_os MATCHES "^(android|win|mac|linux)$")
    message(FATAL_ERROR "Unsupported V8 packaging target: ${_target_os}")
endif()
set(_tool_suffix "")
if(CMAKE_HOST_WIN32)
    set(_tool_suffix .exe)
endif()
file(REAL_PATH "${ENGINE_V8_OUTPUT}" _out)
get_filename_component(_engine_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(REAL_PATH "${_engine_root}/build" _allowed_root)
cmake_path(IS_PREFIX _allowed_root "${_out}" NORMALIZE _inside_build)
if(NOT _inside_build OR _out STREQUAL _allowed_root)
    message(FATAL_ERROR "V8 packaging output must be inside the repository build directory")
endif()
get_filename_component(_source "${_out}/../.." ABSOLUTE)
set(_ninja_file "${_out}/obj/v8_monolith.ninja")
if(NOT EXISTS "${_ninja_file}")
    message(FATAL_ERROR "Missing GN monolith rules: ${_ninja_file}")
endif()

# 使用该固定 GN 实际生成的精确依赖集合，不能用宽泛 glob 混入其他配置/工具的库。
file(STRINGS "${_ninja_file}" _rust_lines REGEX "^  rlibs = ")
list(LENGTH _rust_lines _rust_line_count)
if(NOT _rust_line_count EQUAL 1)
    message(FATAL_ERROR "Expected one GN Rust archive list; refusing to omit Temporal dependencies")
endif()
string(REGEX REPLACE "^  rlibs = " "" _rust_line "${_rust_lines}")
separate_arguments(_rust_archives UNIX_COMMAND "${_rust_line}")
if(NOT _rust_archives)
    message(FATAL_ERROR "GN monolith has no Rust archives; Temporal must remain enabled")
endif()
file(STRINGS "${_ninja_file}" _build_lines REGEX "^build obj/[^ ]*v8_monolith\\.(lib|a): ")
list(LENGTH _build_lines _build_line_count)
if(NOT _build_line_count EQUAL 1)
    message(FATAL_ERROR "Cannot locate the GN monolith archive build edge")
endif()
string(FIND "${_build_lines}" " | " _implicit_start)
if(_implicit_start LESS 0)
    message(FATAL_ERROR "Cannot locate GN implicit compiler runtime dependencies")
endif()
math(EXPR _implicit_start "${_implicit_start} + 3")
string(SUBSTRING "${_build_lines}" ${_implicit_start} -1 _implicit)
string(FIND "${_implicit}" " || " _order_only_start)
if(NOT _order_only_start LESS 0)
    string(SUBSTRING "${_implicit}" 0 ${_order_only_start} _implicit)
endif()
_engine_v8_parse_ninja_paths("${_implicit}" _implicit_dependencies)
set(_runtime_archives)
foreach(_dependency IN LISTS _implicit_dependencies)
    if(_dependency MATCHES "\\.(lib|a)$")
        list(APPEND _runtime_archives "${_dependency}")
    endif()
endforeach()
if(_target_os STREQUAL "win")
    set(_monolith "${_out}/obj/v8_monolith.lib")
    set(_library "${_out}/obj/engine_v8.lib")
    set(_archiver "${_source}/third_party/llvm-build/Release+Asserts/bin/lld-link${_tool_suffix}")
    if(NOT _runtime_archives)
        message(FATAL_ERROR "Missing GN compiler runtime archive for the Windows Rust dependencies")
    endif()
else()
    set(_monolith "${_out}/obj/libv8_monolith.a")
    set(_library "${_out}/obj/libengine_v8.a")
    set(_archiver "${_source}/third_party/llvm-build/Release+Asserts/bin/llvm-ar${_tool_suffix}")
endif()
if(_target_os STREQUAL "mac")
    if(DEFINED ENGINE_V8_TARGET_CPU AND NOT ENGINE_V8_TARGET_CPU STREQUAL "")
        set(_archive_processor "${ENGINE_V8_TARGET_CPU}")
    else()
        cmake_host_system_information(RESULT _archive_processor QUERY OS_PLATFORM)
    endif()
    if(_archive_processor MATCHES "^(arm64|aarch64)$")
        set(_native_arch arm64)
    elseif(_archive_processor MATCHES "^(x86_64|x64)$")
        set(_native_arch x86_64)
    else()
        message(FATAL_ERROR "Unsupported macOS V8 archive architecture: ${_archive_processor}")
    endif()
    find_program(_xcrun xcrun REQUIRED)
    execute_process(COMMAND "${_xcrun}" --find lipo
        OUTPUT_VARIABLE _lipo OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
endif()
if(NOT EXISTS "${_archiver}")
    message(FATAL_ERROR "The pinned LLVM archiver is unavailable: ${_archiver}")
endif()
set(_inputs "${_monolith}")
set(_runtime_inputs)
foreach(_archive IN LISTS _rust_archives _runtime_archives)
    set(_is_runtime FALSE)
    if(_archive IN_LIST _runtime_archives)
        set(_is_runtime TRUE)
    endif()
    if(NOT _is_runtime)
        # Rust 列表来自命令变量；隐式依赖的 Ninja 路径已经单独解码。
        string(REPLACE "$:" ":" _archive "${_archive}")
    endif()
    cmake_path(ABSOLUTE_PATH _archive BASE_DIRECTORY "${_out}" NORMALIZE OUTPUT_VARIABLE _absolute_archive)
    list(APPEND _inputs "${_absolute_archive}")
    if(_is_runtime)
        list(APPEND _runtime_inputs "${_absolute_archive}")
    endif()
endforeach()
list(REMOVE_DUPLICATES _inputs)
foreach(_input IN LISTS _inputs)
    if(NOT EXISTS "${_input}")
        message(FATAL_ERROR "Build the GN monolith before packaging; missing ${_input}")
    endif()
endforeach()

file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" _script_hash)
file(SIZE "${_archiver}" _archiver_size)
file(TIMESTAMP "${_archiver}" _archiver_mtime "%Y-%m-%dT%H:%M:%S.%fZ" UTC)
string(JOIN "\n" _input_manifest "${_script_hash}" "${_target_os}" "${ENGINE_V8_TARGET_CPU}"
    "${_archiver}:${_archiver_size}:${_archiver_mtime}" "${_native_arch}" "${_lipo}" ${_inputs})
string(SHA256 _identity "${_input_manifest}")
set(_identity_file "${_out}/obj/.engine-v8-package-identity")
set(_current_identity "")
if(EXISTS "${_identity_file}")
    file(READ "${_identity_file}" _current_identity)
endif()
set(_repack FALSE)
if(NOT EXISTS "${_library}" OR NOT _current_identity STREQUAL _identity)
    set(_repack TRUE)
else()
    foreach(_input IN LISTS _inputs)
        if("${_input}" IS_NEWER_THAN "${_library}")
            set(_repack TRUE)
        endif()
    endforeach()
endif()
if(NOT _repack)
    message(STATUS "V8 embedding archive is current: ${_library}")
    return()
endif()

set(_temporary "${_library}.tmp")
if(_target_os STREQUAL "win")
    set(_response "")
    foreach(_input IN LISTS _inputs)
        string(APPEND _response "\"${_input}\"\n")
    endforeach()
    set(_response_file "${_out}/obj/engine_v8.rsp")
    file(WRITE "${_response_file}" "${_response}")
    execute_process(COMMAND "${_archiver}" /lib /nologo "/OUT:${_temporary}" "@${_response_file}"
        WORKING_DIRECTORY "${_out}" COMMAND_ERROR_IS_FATAL ANY)
else()
    # MRI ADDLIB 逐个展开归档成员，不能把 rlib 作为嵌套成员塞进最终静态库。
    set(_mri "CREATE \"${_temporary}\"\n")
    foreach(_input IN LISTS _inputs)
        set(_mri_input "${_input}")
        if(_target_os STREQUAL "mac" AND _input IN_LIST _runtime_inputs)
            # Clang 的 Darwin 运行库是通用归档；MRI 只接受目标架构的薄归档。
            execute_process(COMMAND "${_lipo}" -archs "${_input}"
                OUTPUT_VARIABLE _architectures OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
            separate_arguments(_architectures UNIX_COMMAND "${_architectures}")
            if(NOT _native_arch IN_LIST _architectures)
                message(FATAL_ERROR "V8 runtime archive lacks ${_native_arch}: ${_input}")
            endif()
            list(LENGTH _architectures _architecture_count)
            if(_architecture_count GREATER 1)
                string(SHA256 _runtime_id "${_input}")
                file(MAKE_DIRECTORY "${_out}/obj/engine_v8_runtime")
                set(_mri_input "${_out}/obj/engine_v8_runtime/${_runtime_id}-${_native_arch}.a")
                execute_process(COMMAND "${_lipo}" "${_input}" -thin "${_native_arch}" -output "${_mri_input}.tmp"
                    COMMAND_ERROR_IS_FATAL ANY)
                file(RENAME "${_mri_input}.tmp" "${_mri_input}")
            endif()
        endif()
        string(APPEND _mri "ADDLIB \"${_mri_input}\"\n")
    endforeach()
    string(APPEND _mri "SAVE\nEND\n")
    set(_mri_file "${_out}/obj/engine_v8.mri")
    file(WRITE "${_mri_file}" "${_mri}")
    execute_process(COMMAND "${_archiver}" -M INPUT_FILE "${_mri_file}"
        WORKING_DIRECTORY "${_out}" COMMAND_ERROR_IS_FATAL ANY)
endif()
file(RENAME "${_temporary}" "${_library}")
file(WRITE "${_identity_file}" "${_identity}")
list(LENGTH _rust_archives _rust_count)
message(STATUS "Packaged V8 with ${_rust_count} Rust archives: ${_library}")
