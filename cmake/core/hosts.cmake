if(ENGINE_BUILD_APP AND ENGINE_ENABLE_RUNTIME_DEPS)
    if(ANDROID)
        add_library(engine_app SHARED src/main.cpp)
        set_target_properties(engine_app PROPERTIES OUTPUT_NAME main)
    else()
        add_executable(engine_app src/main.cpp)
    endif()
    target_link_libraries(engine_app PRIVATE engine::runtime SDL3::SDL3 fmt::fmt)
    target_include_directories(engine_app PRIVATE "${PROJECT_SOURCE_DIR}/src/engine")
    if(TARGET engine_platform)
        target_link_libraries(engine_app PRIVATE engine::app engine::log)
        target_compile_definitions(engine_app PRIVATE ENGINE_HAS_APP_SERVICES=1)
    else()
        target_compile_definitions(engine_app PRIVATE ENGINE_HAS_APP_SERVICES=0)
    endif()
    engine_link_resource_plugin(engine_app)
    engine_link_script_plugin(engine_app)
    engine_link_animation_retarget_plugin(engine_app)
    engine_link_character_plugin(engine_app)
    engine_link_navigation_crowd_plugin(engine_app)
    engine_link_effects_plugin(engine_app)
    engine_link_terrain_plugin(engine_app)
    engine_link_destruction_plugin(engine_app)
    engine_apply_options(engine_app)
    engine_enable_profiling(engine_app)
    if(ANDROID)
        include(platforms/android/native_bundle.cmake)
    endif()
elseif(ENGINE_BUILD_APP)
    message(STATUS "engine_app requires ENGINE_ENABLE_RUNTIME_DEPS; building core only")
endif()

function(engine_configure_runtime_settings target)
    if(ANDROID)
        target_compile_definitions(${target} PRIVATE
            ENGINE_RUNTIME_SETTINGS_PATH="settings/runtime.json")
    else()
        target_compile_definitions(${target} PRIVATE
            ENGINE_RUNTIME_SETTINGS_PATH="../settings/runtime.json")
    endif()
endfunction()
if(TARGET engine_app)
    engine_configure_runtime_settings(engine_app)
endif()
