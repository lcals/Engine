include_guard(GLOBAL)

function(engine_copy_usd_data target)
    if(NOT WIN32 OR NOT TARGET usd)
        return()
    endif()
    get_target_property(_usd_type usd TYPE)
    if(NOT _usd_type STREQUAL "STATIC_LIBRARY")
        return()
    endif()
    if(CMAKE_CONFIGURATION_TYPES)
        set(_configurations ${CMAKE_CONFIGURATION_TYPES})
    else()
        set(_configurations ${CMAKE_BUILD_TYPE})
        if(NOT _configurations)
            set(_configurations NOCONFIG)
        endif()
    endif()
    foreach(_configuration IN LISTS _configurations)
        string(TOUPPER "${_configuration}" _upper_configuration)
        get_target_property(_library usd "IMPORTED_LOCATION_${_upper_configuration}")
        if(NOT _library)
            get_target_property(_library usd IMPORTED_LOCATION)
        endif()
        if(NOT _library)
            get_target_property(_library usd IMPORTED_LOCATION_RELEASE)
        endif()
        get_filename_component(_library_directory "${_library}" DIRECTORY)
        set(_source "${_library_directory}/usd")
        if(NOT EXISTS "${_source}/plugInfo.json")
            message(FATAL_ERROR "Missing static USD registry: ${_source}/plugInfo.json")
        endif()
        get_target_property(_output ${target} "RUNTIME_OUTPUT_DIRECTORY_${_upper_configuration}")
        if(NOT _output)
            get_target_property(_output ${target} RUNTIME_OUTPUT_DIRECTORY)
            if(NOT _output)
                set(_output "${CMAKE_CURRENT_BINARY_DIR}")
            endif()
            if(CMAKE_CONFIGURATION_TYPES AND NOT _output MATCHES "\\$<")
                string(APPEND _output "/${_configuration}")
            endif()
        endif()
        string(REPLACE "$<CONFIG>" "${_configuration}" _output "${_output}")
        if(NOT IS_ABSOLUTE "${_output}")
            set(_output "${CMAKE_CURRENT_BINARY_DIR}/${_output}")
        endif()
        string(SHA256 _data_id "${_output}/usd")
        set(_data_target "engine_usd_data_${_data_id}")
        if(NOT TARGET ${_data_target})
            file(
                GLOB_RECURSE _files CONFIGURE_DEPENDS
                LIST_DIRECTORIES FALSE
                RELATIVE "${_source}"
                "${_source}/*")
            set(_outputs)
            foreach(_file IN LISTS _files)
                set(_destination "${_output}/usd/${_file}")
                get_filename_component(_directory "${_destination}" DIRECTORY)
                add_custom_command(
                    OUTPUT "${_destination}"
                    COMMAND "${CMAKE_COMMAND}" -E make_directory "${_directory}"
                    COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_source}/${_file}"
                            "${_destination}"
                    DEPENDS "${_source}/${_file}"
                    VERBATIM)
                list(APPEND _outputs "${_destination}")
            endforeach()
            add_custom_target(${_data_target} DEPENDS ${_outputs})
        endif()
        add_dependencies(${target} ${_data_target})
    endforeach()
endfunction()
