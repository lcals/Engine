include_guard(GLOBAL)

# 每份插件 CMake 登记一次；目标只在清单选中后创建。
function(engine_register_plugin)
    cmake_parse_arguments(P "" "NAME;CONFIGURE" "DEPENDS;OPTIONS;VCPKG_FEATURES" ${ARGN})
    if(P_UNPARSED_ARGUMENTS
       OR NOT P_NAME MATCHES "^(runtime|editor)/[a-z0-9_]+$"
       OR NOT P_CONFIGURE)
        message(FATAL_ERROR "Invalid plugin declaration: ${P_NAME}")
    endif()
    if(NOT COMMAND "${P_CONFIGURE}")
        message(FATAL_ERROR "Unknown plugin configuration function: ${P_CONFIGURE}")
    endif()
    get_property(_registered GLOBAL PROPERTY "ENGINE_PLUGIN_${P_NAME}_CONFIGURE")
    if(_registered)
        message(FATAL_ERROR "Duplicate plugin: ${P_NAME}")
    endif()
    foreach(_field CONFIGURE DEPENDS OPTIONS VCPKG_FEATURES)
        set_property(GLOBAL PROPERTY "ENGINE_PLUGIN_${P_NAME}_${_field}" "${P_${_field}}")
    endforeach()
endfunction()

function(engine_resolve_plugin name)
    get_property(_configure GLOBAL PROPERTY "ENGINE_PLUGIN_${name}_CONFIGURE")
    if(NOT _configure)
        message(FATAL_ERROR "Unknown plugin: ${name}")
    endif()
    get_property(_state GLOBAL PROPERTY "ENGINE_PLUGIN_${name}_STATE")
    if(_state STREQUAL "resolved")
        return()
    elseif(_state STREQUAL "visiting")
        message(FATAL_ERROR "Plugin dependency cycle: ${name}")
    endif()
    if(ENGINE_PLUGIN_DEVICE_BUILD AND name MATCHES "^editor/")
        message(FATAL_ERROR "Editor plugin is not available in a device build: ${name}")
    endif()
    get_property(_options GLOBAL PROPERTY "ENGINE_PLUGIN_${name}_OPTIONS")
    foreach(_option IN LISTS _options)
        if(NOT ${_option})
            message(FATAL_ERROR "Plugin ${name} requires ${_option}")
        endif()
    endforeach()
    set_property(GLOBAL PROPERTY "ENGINE_PLUGIN_${name}_STATE" visiting)
    get_property(_dependencies GLOBAL PROPERTY "ENGINE_PLUGIN_${name}_DEPENDS")
    foreach(_dependency IN LISTS _dependencies)
        if(name MATCHES "^runtime/" AND _dependency MATCHES "^editor/")
            message(FATAL_ERROR "Runtime plugin cannot depend on editor plugin: ${name}")
        endif()
        engine_resolve_plugin("${_dependency}")
    endforeach()
    set_property(GLOBAL PROPERTY "ENGINE_PLUGIN_${name}_STATE" resolved)
    set_property(GLOBAL APPEND PROPERTY ENGINE_RESOLVED_PLUGINS "${name}")
endfunction()

function(engine_configure_selected_plugins)
    foreach(_plugin IN LISTS ENGINE_SELECTED_PLUGINS)
        get_property(_configure GLOBAL PROPERTY "ENGINE_PLUGIN_${_plugin}_CONFIGURE")
        cmake_language(CALL "${_configure}")
    endforeach()
endfunction()
