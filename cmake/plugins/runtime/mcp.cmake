function(engine_configure_runtime_mcp_plugin)
    engine_add_system(plugins/runtime mcp)
    target_sources(engine_mcp PRIVATE src/engine/plugins/runtime/mcp/mcp_schema.cpp
        src/engine/plugins/runtime/mcp/mcp_command_channel.cpp)
    target_include_directories(engine_mcp PRIVATE "${PROJECT_SOURCE_DIR}/src/engine")
    target_link_libraries(engine_mcp PUBLIC nlohmann_json::nlohmann_json)
    target_link_libraries(engine_mcp PRIVATE SDL3::SDL3)
    target_compile_definitions(engine_mcp PUBLIC JSON_NOEXCEPTION=1)
    if(ENGINE_ENABLE_RUNTIME_DEPS)
        add_library(engine_mcp_observation STATIC src/engine/plugins/runtime/mcp/runtime_values.cpp)
        add_library(engine::mcp_observation ALIAS engine_mcp_observation)
        target_include_directories(engine_mcp_observation PRIVATE "${PROJECT_SOURCE_DIR}/src/engine")
        target_link_libraries(engine_mcp_observation PUBLIC engine::mcp PRIVATE engine::runtime engine::app SDL3::SDL3)
        engine_apply_options(engine_mcp_observation)
    endif()
    if(ENGINE_ENABLE_TEST_SUPPORT)
        add_library(engine_runtime_mcp_tools STATIC src/engine/plugins/runtime/mcp/runtime_mcp_endpoint.cpp)
        add_library(engine::runtime_mcp_tools ALIAS engine_runtime_mcp_tools)
        target_include_directories(engine_runtime_mcp_tools PRIVATE "${PROJECT_SOURCE_DIR}/src/engine")
        target_link_libraries(engine_runtime_mcp_tools PUBLIC engine::mcp_observation PRIVATE engine::runtime engine::app SDL3::SDL3)
        engine_apply_options(engine_runtime_mcp_tools)
    endif()
endfunction()

engine_register_plugin(NAME runtime/mcp CONFIGURE engine_configure_runtime_mcp_plugin)
