include_guard(GLOBAL)
find_package(Git REQUIRED)
set(_lightmapper_source "${PROJECT_SOURCE_DIR}/third_party/lightmapper/lightmapper.h")
set(_lightmapper_patch "${PROJECT_SOURCE_DIR}/third_party/patches/lightmapper/host-readback.patch")
set(_lightmapper_stage "${CMAKE_CURRENT_BINARY_DIR}/source/lightmapper")
if(NOT EXISTS "${_lightmapper_source}")
    message(FATAL_ERROR "lightmapper is missing; run git submodule update --init third_party/lightmapper")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${_lightmapper_source}" "${_lightmapper_patch}")
file(SHA256 "${_lightmapper_source}" _source_hash)
file(SHA256 "${_lightmapper_patch}" _patch_hash)
set(_fingerprint "${_source_hash}:${_patch_hash}")
set(_previous "")
if(EXISTS "${_lightmapper_stage}/inputs.sha256")
    file(READ "${_lightmapper_stage}/inputs.sha256" _previous)
endif()
if(NOT _previous STREQUAL _fingerprint OR NOT EXISTS "${_lightmapper_stage}/lightmapper.h")
    configure_file("${_lightmapper_source}" "${_lightmapper_stage}/lightmapper.h" COPYONLY)
    execute_process(COMMAND "${GIT_EXECUTABLE}" apply --no-index "${_lightmapper_patch}"
        WORKING_DIRECTORY "${_lightmapper_stage}" RESULT_VARIABLE _status ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "Cannot prepare lightmapper host readback patch: ${_error}")
    endif()
    file(WRITE "${_lightmapper_stage}/inputs.sha256" "${_fingerprint}")
endif()
add_library(engine_lightmapper INTERFACE)
add_library(lightmapper::lightmapper ALIAS engine_lightmapper)
target_include_directories(engine_lightmapper SYSTEM INTERFACE "${_lightmapper_stage}")
