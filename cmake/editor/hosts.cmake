if(ENGINE_BUILD_APP AND ENGINE_ENABLE_EDITOR_DEPS)
    add_executable(editor_app src/editor_main.cpp)
    target_link_libraries(
        editor_app
        PRIVATE engine::editor
                engine::project
                engine::runtime
                engine::app
                engine::log
                SDL3::SDL3
                fmt::fmt)
    if(TARGET engine_asset_pipeline)
        target_link_libraries(editor_app PRIVATE engine::asset_pipeline)
        target_compile_definitions(editor_app PRIVATE ENGINE_HAS_ASSET_PIPELINE=1)
    else()
        target_compile_definitions(editor_app PRIVATE ENGINE_HAS_ASSET_PIPELINE=0)
    endif()
    engine_link_script_plugin(editor_app)
    engine_link_character_plugin(editor_app)
    engine_link_resource_plugin(editor_app)
    engine_link_modeling_importer(editor_app)
    engine_link_asset_importers(editor_app)
    engine_link_controller_editor(editor_app)
    if(TARGET engine_modeling_editor)
        target_link_libraries(editor_app PRIVATE engine::modeling_editor)
        target_compile_definitions(editor_app PRIVATE ENGINE_HAS_MODELING_PLUGIN=1)
    else()
        target_compile_definitions(editor_app PRIVATE ENGINE_HAS_MODELING_PLUGIN=0)
    endif()
    engine_apply_options(editor_app)
endif()

