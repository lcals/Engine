function(engine_link_controller_editor target)
    if(TARGET engine_character_controller_editor)
        target_link_libraries(${target} PRIVATE engine::character_controller_editor)
        target_compile_definitions(${target} PRIVATE ENGINE_HAS_CHARACTER_CONTROLLER_EDITOR=1)
    else()
        target_compile_definitions(${target} PRIVATE ENGINE_HAS_CHARACTER_CONTROLLER_EDITOR=0)
    endif()
    if(TARGET engine_character_controller_mcp_tools AND target STREQUAL "mcp_app")
        target_link_libraries(${target} PRIVATE engine::character_controller_mcp_tools)
        target_compile_definitions(${target} PRIVATE ENGINE_HAS_CHARACTER_CONTROLLER_MCP=1)
    else()
        target_compile_definitions(${target} PRIVATE ENGINE_HAS_CHARACTER_CONTROLLER_MCP=0)
    endif()
endfunction()

function(engine_link_asset_importers target)
    foreach(_format fbx usd font ui)
        string(TOUPPER "${_format}" _upper)
        if(TARGET engine_${_format}_import)
            target_link_libraries(${target} PRIVATE engine::${_format}_import)
            target_compile_definitions(${target} PRIVATE ENGINE_HAS_${_upper}_IMPORTER=1)
        else()
            target_compile_definitions(${target} PRIVATE ENGINE_HAS_${_upper}_IMPORTER=0)
        endif()
    endforeach()
endfunction()

