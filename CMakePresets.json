{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_BUILD_APP": true,
        "ENGINE_BUILD_TESTS": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENGINE_BUILD_APP": true,
        "ENGINE_BUILD_TESTS": true,
        "BUILD_TESTING": true
      }
    },
    {
      "name": "runtime-deps",
      "displayName": "Runtime dependencies",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/runtime-deps",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "runtime",
        "ENGINE_ENABLE_RUNTIME_DEPS": true
      }
    },
    {
      "name": "asset-pipeline-deps",
      "displayName": "Asset pipeline dependencies",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asset-pipeline-deps",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "asset-pipeline",
        "ENGINE_ENABLE_ASSET_PIPELINE_DEPS": true
      }
    },
    {
      "name": "editor-deps",
      "displayName": "Editor and runtime dependencies",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/editor-deps",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "runtime;editor;asset-pipeline",
        "ENGINE_ENABLE_RUNTIME_DEPS": true,
        "ENGINE_ENABLE_EDITOR_DEPS": true,
        "ENGINE_ENABLE_ASSET_PIPELINE_DEPS": true
      }
    },
    {
      "name": "v8-debug",
      "displayName": "V8 Debug embedding verification",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/v8-debug",
      "cacheVariables": {
        "ENGINE_ENABLE_V8": true
      }
    },
    {
      "name": "v8-release",
      "displayName": "V8 Release embedding verification",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/v8-release",
      "cacheVariables": {
        "ENGINE_ENABLE_V8": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "v8-prepare-release",
      "configurePreset": "v8-release",
      "configuration": "Release",
      "targets": ["engine_v8_prepare"]
    },
    {
      "name": "v8-prepare-debug",
      "configurePreset": "v8-debug",
      "configuration": "Debug",
      "targets": ["engine_v8_prepare"]
    },
    {
      "name": "v8-debug",
      "configurePreset": "v8-debug",
      "configuration": "Debug",
      "targets": ["engine_v8_test", "engine_app", "engine_tests"]
    },
    {
      "name": "v8-release",
      "configurePreset": "v8-release",
      "configuration": "Release",
      "targets": ["engine_v8_test", "engine_app", "engine_tests"]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "v8-debug",
      "inherits": "debug",
      "configurePreset": "v8-debug"
    },
    {
      "name": "v8-release",
      "inherits": "release",
      "configurePreset": "v8-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "v8-debug",
      "steps": [
        { "type": "configure", "name": "v8-debug" },
        { "type": "build", "name": "v8-prepare-debug" },
        { "type": "build", "name": "v8-debug" },
        { "type": "test", "name": "v8-debug" }
      ]
    },
    {
      "name": "v8-release",
      "steps": [
        { "type": "configure", "name": "v8-release" },
        { "type": "build", "name": "v8-prepare-release" },
        { "type": "build", "name": "v8-release" },
        { "type": "test", "name": "v8-release" }
      ]
    }
  ]
}
