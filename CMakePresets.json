      "inherits": "ninja-engine-debug-prepare",
      "configurePreset": "windows-static-debug"
    },
    {
      "name": "windows-static-release-prepare",
      "inherits": "ninja-engine-release-prepare",
      "configurePreset": "windows-static-release"
    },
    {
