{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VSLANG": "1033"
      }
    },
    {
      "name": "ninja-cache",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "ENGINE_USE_COMPILER_CACHE": true,
        "ENGINE_REQUIRE_COMPILER_CACHE": true
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENGINE_BUILD_APP": true,
        "ENGINE_BUILD_TESTS": true,
        "BUILD_TESTING": true,
        "VCPKG_MANIFEST_FEATURES": "runtime",
        "ENGINE_ENABLE_RUNTIME_DEPS": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/dependencies/runtime"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "vcpkg",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENGINE_BUILD_APP": true,
        "ENGINE_BUILD_TESTS": true,
        "BUILD_TESTING": true,
        "VCPKG_MANIFEST_FEATURES": "runtime",
        "ENGINE_ENABLE_RUNTIME_DEPS": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/dependencies/runtime"
      }
    },
    {
      "name": "runtime-deps",
      "displayName": "Runtime dependencies",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/runtime-deps",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "runtime",
        "ENGINE_ENABLE_RUNTIME_DEPS": true
      }
    },
    {
      "name": "asset-pipeline-deps",
      "displayName": "Asset pipeline dependencies",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asset-pipeline-deps",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "runtime;asset-pipeline",
        "ENGINE_ENABLE_ASSET_PIPELINE_DEPS": true,
        "ENGINE_ENABLE_RUNTIME_DEPS": true,
        "ENGINE_BUILD_APP": false,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/dependencies/asset-pipeline"
      }
    },
    {
      "name": "editor-deps",
      "displayName": "Editor and runtime dependencies",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/editor-deps",
      "cacheVariables": {
        "VCPKG_MANIFEST_FEATURES": "runtime;editor;asset-pipeline",
        "ENGINE_ENABLE_RUNTIME_DEPS": true,
        "ENGINE_ENABLE_EDITOR_DEPS": true,
        "ENGINE_ENABLE_ASSET_PIPELINE_DEPS": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/dependencies/editor"
      }
    },
    {
      "name": "editor-deps-release",
      "displayName": "Editor and runtime dependencies Release",
      "inherits": "editor-deps",
      "binaryDir": "${sourceDir}/build/editor-deps-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "v8-debug",
      "displayName": "V8 Debug embedding verification",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/v8-debug",
      "cacheVariables": {
        "ENGINE_ENABLE_V8": true,
        "ENGINE_ENABLE_RUNTIME_DEPS": false,
        "ENGINE_BUILD_APP": false,
        "VCPKG_MANIFEST_FEATURES": "",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/dependencies/base"
      }
    },
    {
      "name": "v8-release",
      "displayName": "V8 Release embedding verification",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/v8-release",
      "cacheVariables": {
        "ENGINE_ENABLE_V8": true,
        "ENGINE_ENABLE_RUNTIME_DEPS": false,
        "ENGINE_BUILD_APP": false,
        "VCPKG_MANIFEST_FEATURES": "",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/dependencies/base"
      }
    },
    {
      "name": "engine-debug",
      "displayName": "All engine systems debug",
      "inherits": "editor-deps",
      "binaryDir": "${sourceDir}/build/engine-debug",
      "cacheVariables": {
        "ENGINE_ENABLE_V8": true,
        "ENGINE_ENABLE_SCRIPT_RUNTIME": true
      }
    },
    {
      "name": "engine-release",
      "displayName": "All engine systems release",
      "inherits": "editor-deps-release",
      "binaryDir": "${sourceDir}/build/engine-release",
      "cacheVariables": {
        "ENGINE_ENABLE_V8": true,
        "ENGINE_ENABLE_SCRIPT_RUNTIME": true
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja cached debug",
      "inherits": [
        "ninja-cache",
        "debug"
      ],
      "binaryDir": "${sourceDir}/build/ninja-debug"
    },
    {
      "name": "ninja-release",
      "displayName": "Ninja cached release",
      "inherits": [
        "ninja-cache",
        "release"
      ],
      "binaryDir": "${sourceDir}/build/ninja-release"
    },
    {
      "name": "ninja-engine-debug",
      "displayName": "Ninja cached engine-debug",
      "inherits": [
        "ninja-cache",
        "engine-debug"
      ],
      "binaryDir": "${sourceDir}/build/ninja-engine-debug"
    },
    {
      "name": "ninja-engine-release",
      "displayName": "Ninja cached engine-release",
      "inherits": [
        "ninja-cache",
        "engine-release"
      ],
      "binaryDir": "${sourceDir}/build/ninja-engine-release"
    },
    {
      "name": "windows-static",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "CMAKE_BUILD_PARALLEL_LEVEL": "16",
        "VCPKG_MAX_CONCURRENCY": "16"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_HOST_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/dependencies/windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "BUILD_SHARED_LIBS": false,
        "ENGINE_V8_JOBS": "16",
        "ENGINE_ENABLE_GPU_TESTS": true
      }
    },
    {
      "name": "windows-static-debug",
      "inherits": ["windows-static", "ninja-engine-debug"],
      "binaryDir": "${sourceDir}/build/windows-static-debug"
    },
    {
      "name": "windows-static-release",
      "inherits": ["windows-static", "ninja-engine-release"],
      "binaryDir": "${sourceDir}/build/windows-static-release"
    },
    {
      "name": "android-arm64-debug",
      "displayName": "Android ARM64 Debug",
      "inherits": [
        "ninja-cache",
        "vcpkg"
      ],
      "binaryDir": "${sourceDir}/build/android-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "arm64-android-engine",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/third_party/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/dependencies/android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "VCPKG_MANIFEST_FEATURES": "runtime",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared",
        "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": true,
        "CMAKE_POSITION_INDEPENDENT_CODE": true,
        "ENGINE_ENABLE_RUNTIME_DEPS": true,
        "ENGINE_ENABLE_EDITOR_DEPS": false,
        "ENGINE_ENABLE_ASSET_PIPELINE_DEPS": false,
        "ENGINE_ENABLE_V8": true,
        "ENGINE_ENABLE_SCRIPT_RUNTIME": true,
        "ENGINE_BUILD_APP": true,
        "ENGINE_BUILD_TESTS": false,
        "BUILD_TESTING": false
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android ARM64 Release",
      "inherits": [
        "ninja-cache",
        "vcpkg"
      ],
      "binaryDir": "${sourceDir}/build/android-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "arm64-android-engine",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/third_party/triplets",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/dependencies/android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "VCPKG_MANIFEST_FEATURES": "runtime",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared",
        "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": true,
        "CMAKE_POSITION_INDEPENDENT_CODE": true,
        "ENGINE_ENABLE_RUNTIME_DEPS": true,
        "ENGINE_ENABLE_EDITOR_DEPS": false,
        "ENGINE_ENABLE_ASSET_PIPELINE_DEPS": false,
        "ENGINE_ENABLE_V8": true,
        "ENGINE_ENABLE_SCRIPT_RUNTIME": true,
        "ENGINE_BUILD_APP": true,
        "ENGINE_BUILD_TESTS": false,
        "BUILD_TESTING": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-static-debug",
      "configurePreset": "windows-static-debug",
      "jobs": 16,
      "configuration": "Debug"
    },
    {
      "name": "windows-static-release",
      "configurePreset": "windows-static-release",
      "jobs": 16,
      "configuration": "Release"
    },
    {
