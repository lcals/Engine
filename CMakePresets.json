      "targets": [
        "engine_v8_prepare"
      ]
    },
    {
      "name": "engine-release",
      "configurePreset": "engine-release",
      "configuration": "Release"
    },
    {
      "name": "engine-release-prepare",
      "configurePreset": "engine-release",
      "configuration": "Release",
