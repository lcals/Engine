    },
    {
      "name": "ninja-engine-debug-prepare",
      "configurePreset": "ninja-engine-debug",
      "configuration": "Debug",
      "targets": [
        "engine_v8_prepare"
      ]
    },
    {
      "name": "ninja-engine-release",
      "configurePreset": "ninja-engine-release",
      "configuration": "Release"
    },
    {
      "name": "ninja-engine-release-prepare",
      "configurePreset": "ninja-engine-release",
