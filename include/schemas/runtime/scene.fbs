include "common.fbs";
namespace engine.schema;

table TransformData {
    position:Vec3 (required, native_inline);
    rotation:Vec3 (required, native_inline);
    scale:Vec3 (required, native_inline, native_default: "Vec3(1.0, 1.0, 1.0)");
}

enum Projection:ubyte { perspective, orthographic }
enum LightKind:ubyte { directional, point, spot }

table CameraData {
    fov_degrees:float = 60;
    near_clip:float = 0.1;
    far_clip:float = 1000;
    projection:Projection = perspective;
    orthographic_size:float = 5;
}

table LightData {
    color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    intensity:float = 3;
    kind:LightKind = directional;
    range:float = 10;
    inner_angle:float = 20;
    outer_angle:float = 30;
    cast_shadows:bool = false;
    shadow_resolution:ushort = 2048;
    shadow_bias:float = 0.001;
    shadow_cascades:ubyte = 4;
    shadow_distance:float = 150;
    shadow_split_lambda:float = 0.6;
    shadow_cascade_blend:float = 0.1;
}

table MeshRendererData {
    mesh_guid:string (required);
    material_guid:string (required);
    additional_material_guids:[string];
    cast_shadows:bool = true;
}

enum ColliderShape:ubyte { box, sphere, capsule, mesh }
enum BodyMotion:ubyte { static_body, kinematic, dynamic }

table ColliderData {
    shape:ColliderShape = box;
    half_extents:Vec3 (required, native_inline, native_default: "Vec3(0.5, 0.5, 0.5)");
    radius:float = 0.5;
    half_height:float = 0.5;
    center:Vec3 (required, native_inline);
    friction:float = 0.5;
    restitution:float = 0.1;
    is_trigger:bool = false;
    mesh_guid:string;
}

table RigidBodyData {
    motion:BodyMotion = dynamic;
    mass:float = 1;
    gravity_factor:float = 1;
    linear_damping:float = 0.05;
    angular_damping:float = 0.05;
    linear_velocity:Vec3 (required, native_inline);
    angular_velocity:Vec3 (required, native_inline);
}

table AudioSourceData {
    clip_guid:string;
    volume:float = 1;
    pitch:float = 1;
    loop:bool = false;
    play_on_awake:bool = true;
    spatial:bool = true;
    min_distance:float = 1;
    max_distance:float = 20;
}

table AudioListenerData {
    volume:float = 1;
}

table AnimatorData {
    animation_guid:string;
    speed:float = 1;
    loop:bool = true;
    play_on_awake:bool = true;
}

table CharacterMotorData {
    radius:float = 0.3;
    half_height:float = 0.6;
    max_slope_degrees:float = 50;
    step_height:float = 0.35;
    ground_snap_distance:float = 0.2;
    gravity_factor:float = 1;
}

enum CharacterView:ubyte { first_person, third_person }
table CharacterControllerData {
    mode:CharacterView = third_person;
    move_speed:float = 4;
    jump_speed:float = 5;
    look_sensitivity:float = 0.12;
    eye_height:float = 1.6;
    camera_distance:float = 4;
    pitch_min:float = -80;
    pitch_max:float = 80;
    camera_node_id:ulong;
}

table UiData {
    document_guid:string;
}

table TextData {
    font_guid:string;
    shader_path:string;
    text:string;
    size:float = 1;
    color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    letter_spacing:float = 0;
}

enum FogMode:ubyte { none, linear, exponential, exponential_squared }

table EnvironmentData {
    ambient_color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    ambient_intensity:float = 0;
    ambient_tricolor:bool = false;
    ambient_sky_color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    ambient_equator_color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    ambient_ground_color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    fog_mode:FogMode = none;
    fog_color:Color (required, native_inline, native_default: "Color(0.5f, 0.5f, 0.5f, 1.0f)");
    fog_start:float = 0;
    fog_end:float = 100;
    fog_density:float = 0.01;
    clear_color:uint = 0x181818ff;
    ibl_enabled:bool = false;
    ibl_intensity:float = 1;
    ibl_irradiance_guid:string;
    ibl_prefilter_guid:string;
    ibl_lut_guid:string;
}

table PostProcessData {
    exposure:float = 1;
    filmic_tonemap:bool = false;
    ao_enabled:bool = false;
    ao_radius:float = 1;
    ao_strength:float = 1;
    ao_power:float = 1.5;
    ao_fade_start:float = 80;
    ao_fade_end:float = 150;
    hdr_enabled:bool = false;
    bloom_enabled:bool = false;
    bloom_threshold:float = 1;
    bloom_intensity:float = 0.15;
    bloom_radius:float = 1;
}

union ComponentPayload {
    TransformData, CameraData, LightData, MeshRendererData,
    ColliderData, RigidBodyData, AudioSourceData, AudioListenerData, AnimatorData, CharacterMotorData,
    CharacterControllerData, UiData, TextData, EnvironmentData, PostProcessData
}

table ComponentData {
    enabled:bool = true;
    payload:ComponentPayload (required);
}

table NodeInfo {
    id:ulong;
    name:string;
    parent_id:ulong;
}

table NodeData {
    info:NodeInfo (required);
    components:[ComponentData];
}

table SceneInfo {
    name:string;
    active_camera_node:ulong;
}

table SceneData {
    schema_version:uint = 1;
    info:SceneInfo (required);
    nodes:[NodeData];
}

root_type SceneData;
file_identifier "ESCN";
file_extension "scene";
