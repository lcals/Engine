include "animation_pose.fbs";
include "common.fbs";
namespace engine.schema;

table TransformData {
    position:Vec3 (required, native_inline);
    rotation:Vec3 (required, native_inline);
    scale:Vec3 (required, native_inline, native_default: "Vec3(1.0, 1.0, 1.0)");
}

enum Projection:ubyte { perspective, orthographic }
enum LightKind:ubyte { directional, point, spot }

table CameraData {
    fov_degrees:float = 60;
    near_clip:float = 0.1;
    far_clip:float = 1000;
    projection:Projection = perspective;
    orthographic_size:float = 5;
    frustum_culling_enabled:bool = false;
}

table LightData {
    color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    intensity:float = 3;
    kind:LightKind = directional;
    range:float = 10;
    inner_angle:float = 20;
    outer_angle:float = 30;
    cast_shadows:bool = false;
    shadow_resolution:ushort = 2048;
    shadow_bias:float = 0.001;
    shadow_cascades:ubyte = 4;
    shadow_distance:float = 150;
    shadow_split_lambda:float = 0.6;
    shadow_cascade_blend:float = 0.1;
}

table MeshRendererData {
    mesh_guid:string (required);
    material_guid:string (required);
    additional_material_guids:[string];
    cast_shadows:bool = true;
    bake_static:bool = false;
    lightmap_guid:string;
    lightmap_mesh_hash:string;
    lightmap_transform:[float];
    static_instancing_enabled:bool = false;
    static_lod_enabled:bool = false;
}

enum ColliderShape:ubyte { box, sphere, capsule, mesh, compound }
enum BodyMotion:ubyte { static_body, kinematic, dynamic }

// Each hull uses the owning body's local coordinates. Jolt computes its convex hull.
table ColliderHullData {
    vertices:[Vec3] (required);
}

table ColliderData {
    shape:ColliderShape = box;
    half_extents:Vec3 (required, native_inline, native_default: "Vec3(0.5, 0.5, 0.5)");
    radius:float = 0.5;
    half_height:float = 0.5;
    center:Vec3 (required, native_inline);
    friction:float = 0.5;
    restitution:float = 0.1;
    is_trigger:bool = false;
    mesh_guid:string;
    hulls:[ColliderHullData];
}

table RigidBodyData {
    motion:BodyMotion = dynamic;
    mass:float = 1;
    gravity_factor:float = 1;
    linear_damping:float = 0.05;
    angular_damping:float = 0.05;
    linear_velocity:Vec3 (required, native_inline);
    angular_velocity:Vec3 (required, native_inline);
}

table AudioSourceData {
    clip_guid:string;
    volume:float = 1;
    pitch:float = 1;
    loop:bool = false;
    play_on_awake:bool = true;
    spatial:bool = true;
    min_distance:float = 1;
    max_distance:float = 20;
}

table AudioListenerData {
    volume:float = 1;
}

table BoneAttachmentData {
    source_node_id:ulong;
    socket_name:string;
    offset:JointLocalPose (required, native_inline, native_default: "JointLocalPose(Vec3(), Vec4(0, 0, 0, 1), Vec3(1, 1, 1))");
    follow_enabled:bool = false;
}

table AnimatorData {
    animation_guid:string;
    speed:float = 1;
    loop:bool = true;
    play_on_awake:bool = true;
    ik_enabled:bool = false;
}

table CharacterMotorData {
    radius:float = 0.3;
    half_height:float = 0.6;
    max_slope_degrees:float = 50;
    step_height:float = 0.35;
    ground_snap_distance:float = 0.2;
    gravity_factor:float = 1;
    external_damping:float = 6;
}

enum CharacterView:ubyte { first_person, third_person }
table CharacterControllerData {
    move_speed:float = 4;
    jump_speed:float = 5;
    look_sensitivity:float = 0.12;
    camera_node_id:ulong;
}

table CharacterCameraData {
    target_node_id:ulong;
    mode:CharacterView = third_person;
    eye_height:float = 1.6;
    camera_distance:float = 4;
    pitch_min:float = -80;
    pitch_max:float = 80;
    collision_radius:float = 0.15;
    collision_margin:float = 0.02;
}

enum CharacterVisualKind:ubyte { body, head, first_person }
table CharacterVisualData {
    kind:CharacterVisualKind = body;
}

table UiData {
    document_guid:string;
}

table TextData {
    font_guid:string;
    shader_path:string;
    text:string;
    size:float = 1;
    color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    letter_spacing:float = 0;
}

enum FogMode:ubyte { none, linear, exponential, exponential_squared }

table EnvironmentData {
    ambient_color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    ambient_intensity:float = 0;
    ambient_tricolor:bool = false;
    ambient_sky_color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    ambient_equator_color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    ambient_ground_color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    fog_mode:FogMode = none;
    fog_color:Color (required, native_inline, native_default: "Color(0.5f, 0.5f, 0.5f, 1.0f)");
    fog_start:float = 0;
    fog_end:float = 100;
    fog_density:float = 0.01;
    clear_color:uint = 0x181818ff;
    ibl_enabled:bool = false;
    ibl_intensity:float = 1;
    ibl_irradiance_guid:string;
    ibl_prefilter_guid:string;
    ibl_lut_guid:string;
    atmosphere_enabled:bool = false;
    atmosphere_sun_node_id:ulong;
    atmosphere_ground_height:float = 0;
    atmosphere_rayleigh_scattering:Vec3 (required, native_inline, native_default: "Vec3(0.00580243, 0.01355776, 0.0331)");
    atmosphere_rayleigh_scale_height:float = 8;
    atmosphere_mie_scattering:float = 0.003996;
    atmosphere_mie_absorption:float = 0.000444;
    atmosphere_mie_scale_height:float = 1.2;
    atmosphere_mie_anisotropy:float = 0.8;
    atmosphere_ozone_absorption:Vec3 (required, native_inline, native_default: "Vec3(0.0006500736, 0.001881, 0.0000850212)");
    atmosphere_ozone_center_height:float = 25;
    atmosphere_ozone_half_width:float = 15;
    atmosphere_planet_radius:float = 6360;
    atmosphere_height:float = 100;
    atmosphere_ground_albedo:Vec3 (required, native_inline, native_default: "Vec3(0.3, 0.3, 0.3)");
    atmosphere_multiscatter_strength:float = 1;
}

table PostProcessData {
    exposure:float = 1;
    filmic_tonemap:bool = false;
    ao_enabled:bool = false;
    ao_radius:float = 1;
    ao_strength:float = 1;
    ao_power:float = 1.5;
    ao_fade_start:float = 80;
    ao_fade_end:float = 150;
    hdr_enabled:bool = false;
    bloom_enabled:bool = false;
    bloom_threshold:float = 1;
    bloom_intensity:float = 0.15;
    bloom_radius:float = 1;
    ssr_enabled:bool = false;
    ssr_resolution_scale:float = 0.5;
    ssr_max_steps:ushort = 64;
    ssr_max_distance:float = 80;
    ssr_thickness:float = 0.15;
    ssr_roughness_cutoff:float = 0.7;
}

table PlanarReflectionData {
    resolution_scale:float = 0.5;
    clip_bias:float = 0.02;
}

table LightProbeVolumeData {
    probes_guid:string;
}

table EffectData {
    effect_guid:string;
    speed:float = 1;
    loop:bool = false;
    play_on_awake:bool = true;
}

table TerrainData {
    terrain_guid:string;
    material_guid:string;
    collision:bool = true;
    surface_color:Color (required, native_inline, native_default: "Color(0.35f, 0.48f, 0.24f, 1.0f)");
    wall_color:Color (required, native_inline, native_default: "Color(0.48f, 0.36f, 0.24f, 1.0f)");
    uv_scale:float = 0.2;
}

table DestructionData {
    destruction_guid:string;
    material_guid:string;
    density:float = 100;
    friction:float = 0.65;
    restitution:float = 0.05;
}

table NavigationAgentData {
    radius:float = 0.3;
    height:float = 1.8;
    max_speed:float = 3;
    max_acceleration:float = 8;
    separation_weight:float = 2;
    arrival_distance:float = 0.15;
    face_velocity:bool = true;
}

union ComponentPayload {
    TransformData, CameraData, LightData, MeshRendererData,
    ColliderData, RigidBodyData, AudioSourceData, AudioListenerData, AnimatorData, CharacterMotorData,
    CharacterControllerData, UiData, TextData, EnvironmentData, PostProcessData,
    CharacterCameraData, CharacterVisualData, EffectData, TerrainData, DestructionData,
    NavigationAgentData, PlanarReflectionData, LightProbeVolumeData, BoneAttachmentData
}

table ComponentFlags {
    enabled:bool = true;
    visible:bool = true;
}

table ComponentData {
    flags:ComponentFlags (required);
    payload:ComponentPayload (required);
}

table NodeProperties {
    id:ulong;
    name:string;
    enabled:bool = true;
    visible:bool = true;
}

table NodeInfo {
    properties:NodeProperties (required);
    parent_id:ulong;
}

table NodeData {
    info:NodeInfo (required);
    components:[ComponentData];
}

table SceneInfo {
    name:string;
    active_camera_node:ulong;
}

// Template-local identity maps to a persistent scene-local identity, never an ECS handle.
table NodeIdMapping {
    source_id:ulong;
    target_id:ulong;
    // Editor composition marks identities deleted by a newer template; IDs remain reserved.
    retired:bool = false;
}

// Only explicitly named codec fields participate in an override, including false/zero.
// Component node references in overrides already use scene-local identities.
table PrefabComponentOverride {
    component:ComponentData (required);
    fields:[string];
    removed:bool = false;
}

table PrefabNodeOverride {
    node_id:ulong;
    info:NodeInfo;
    fields:[string];
    components:[PrefabComponentOverride];
    removed:bool = false;
}

table PrefabInstanceData {
    prefab_guid:string (required);
    root_id:ulong;
    node_mappings:[NodeIdMapping];
    overrides:[PrefabNodeOverride];
}

table SceneData {
    schema_version:uint = 0;
    info:SceneInfo (required);
    nodes:[NodeData];
    prefab_instances:[PrefabInstanceData];
}

root_type SceneData;
file_identifier "ESCN";
file_extension "scene";
