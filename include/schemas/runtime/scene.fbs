include "common.fbs";
namespace engine.schema;

table TransformData {
    position:Vec3 (required, native_inline);
    rotation:Vec3 (required, native_inline);
    scale:Vec3 (required, native_inline, native_default: "Vec3(1.0, 1.0, 1.0)");
}

enum Projection:ubyte { perspective, orthographic }
enum LightKind:ubyte { directional, point, spot }

table CameraData {
    fov_degrees:float = 60;
    near_clip:float = 0.1;
    far_clip:float = 1000;
    projection:Projection = perspective;
    orthographic_size:float = 5;
}

table LightData {
    color:Color (required, native_inline, native_default: "Color(1.0f, 1.0f, 1.0f, 1.0f)");
    intensity:float = 3;
    kind:LightKind = directional;
    range:float = 10;
    inner_angle:float = 20;
    outer_angle:float = 30;
}

table MeshRendererData {
    mesh_guid:string (required);
    material_guid:string (required);
    additional_material_guids:[string];
}

enum ColliderShape:ubyte { box, sphere, capsule }
enum BodyMotion:ubyte { static_body, kinematic, dynamic }

table ColliderData {
    shape:ColliderShape = box;
    half_extents:Vec3 (required, native_inline, native_default: "Vec3(0.5, 0.5, 0.5)");
    radius:float = 0.5;
    half_height:float = 0.5;
    center:Vec3 (required, native_inline);
    friction:float = 0.5;
    restitution:float = 0.1;
    is_trigger:bool = false;
}

table RigidBodyData {
    motion:BodyMotion = dynamic;
    mass:float = 1;
    gravity_factor:float = 1;
    linear_damping:float = 0.05;
    angular_damping:float = 0.05;
    linear_velocity:Vec3 (required, native_inline);
    angular_velocity:Vec3 (required, native_inline);
}

table AudioSourceData {
    clip_guid:string;
    volume:float = 1;
    pitch:float = 1;
    loop:bool = false;
    play_on_awake:bool = true;
    spatial:bool = true;
    min_distance:float = 1;
    max_distance:float = 20;
}

table AudioListenerData {
    volume:float = 1;
}

union ComponentPayload {
    TransformData, CameraData, LightData, MeshRendererData,
    ColliderData, RigidBodyData, AudioSourceData, AudioListenerData
}

table ComponentData {
    enabled:bool = true;
    payload:ComponentPayload (required);
}

table NodeInfo {
    id:ulong;
    name:string;
    parent_id:ulong;
}

table NodeData {
    info:NodeInfo (required);
    components:[ComponentData];
}

table SceneInfo {
    name:string;
    active_camera_node:ulong;
}

table SceneData {
    schema_version:uint = 1;
    info:SceneInfo (required);
    nodes:[NodeData];
}

root_type SceneData;
file_identifier "ESCN";
file_extension "scene";
