include "common.fbs";
namespace engine.schema;

table LightProbeData {
    schema_version:uint = 1;
    path:string (required);
    bounds_min:Vec3 (required, native_inline);
    bounds_max:Vec3 (required, native_inline);
    grid_x:uint;
    grid_y:uint;
    grid_z:uint;
    // Column-major local-to-world matrix at bake time; moving a volume invalidates its bake.
    baked_transform:[float] (required);
    // Probe-major RGB radiance SH9, l=0..2 and m=-l..l, x-fastest grid indexing.
    coefficients:[Vec3] (required);
    valid:[ubyte] (required);
    source_fingerprint:string (required);
}

root_type LightProbeData;
file_identifier "ELPR";
