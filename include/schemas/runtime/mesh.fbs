include "common.fbs";
namespace engine.schema;

struct MeshVertex {
    x:float;
    y:float;
    z:float;
    nx:float;
    ny:float;
    nz:float;
}

struct MeshSubmesh {
    first_index:uint;
    index_count:uint;
    material_slot:uint;
}

table MeshData {
    schema_version:uint = 1;
    path:string (required);
    vertices:[MeshVertex] (required);
    indices:[uint] (required);
    texcoords:[Vec2];
    tangents:[Vec4];
    colors:[Color];
    submeshes:[MeshSubmesh];
}

root_type MeshData;
file_identifier "EMSH";
