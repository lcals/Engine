include "common.fbs";
namespace engine.schema;

struct MeshVertex {
    x:float;
    y:float;
    z:float;
    nx:float;
    ny:float;
    nz:float;
}

struct MeshSubmesh {
    first_index:uint;
    index_count:uint;
    material_slot:uint;
}

struct SkinInfluence {
    j0:ushort;
    j1:ushort;
    j2:ushort;
    j3:ushort;
    w0:float;
    w1:float;
    w2:float;
    w3:float;
}

// Additional static rendering topology; all indices address MeshData.vertices.
table MeshLodData {
    screen_height:float;
    indices:[uint] (required);
    submeshes:[MeshSubmesh];
}

table MeshData {
    schema_version:uint = 1;
    path:string (required);
    vertices:[MeshVertex] (required);
    indices:[uint] (required);
    texcoords:[Vec2];
    tangents:[Vec4];
    colors:[Color];
    submeshes:[MeshSubmesh];
    skeleton_guid:string;
    skin:[SkinInfluence];
    // Column-major bind transform from mesh local space to skeleton/model space.
    mesh_to_skeleton:[float];
    lightmap_texcoords:[Vec2];
    lods:[MeshLodData];
}

root_type MeshData;
file_identifier "EMSH";
