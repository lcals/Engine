include "common.fbs";
include "sampling.fbs";
namespace engine.schema;

struct VectorKey {
    time:float;
    value:Vec3;
}

struct RotationKey {
    time:float;
    value:Vec4;
}

table AnimationTrackData {
    joint:uint;
    translations:[VectorKey] (required);
    rotations:[RotationKey] (required);
    scales:[VectorKey] (required);
}

table AnimationEventBoolean { value:bool; }
table AnimationEventNumber { value:double; }
table AnimationEventString { value:string (required); }
union AnimationEventPayload { AnimationEventBoolean, AnimationEventNumber, AnimationEventString }
table AnimationEventMarkerData {
    marker_id:uint;
    time:float;
    name:string (required);
    payload:AnimationEventPayload;
}

table AnimationData {
    schema_version:uint = 0;
    path:string (required);
    name:string (required);
    skeleton_guid:string (required);
    duration:float;
    tracks:[AnimationTrackData] (required);
    events:[AnimationEventMarkerData];
    sampling_encoding:SamplingEncoding = structured;
    sampling_archive:[ubyte];
    sampling_channels:[ubyte];
}

root_type AnimationData;
file_identifier "EANI";
