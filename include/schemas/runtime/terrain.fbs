include "common.fbs";
namespace engine.schema;

table TerrainSphere {
    center:Vec3 (required, native_inline);
    radius:float = 3;
}

// Inputs shared by TerrainVolume::generate and the editor terrain importer.
table TerrainGeneratorData {
    cells_x:uint = 64;
    cells_y:uint = 32;
    cells_z:uint = 64;
    voxel_size:float = 1;
    chunk_cells:uint = 16;
    origin:Vec3 (required, native_inline);
    height:float = 0;
    amplitude:float = 4;
    frequency:float = 0.08;
    seed:uint = 1;
    cavities:[TerrainSphere];
}

table TerrainAssetData {
    schema_version:uint = 1;
    cells_x:uint;
    cells_y:uint;
    cells_z:uint;
    voxel_size:float = 1;
    chunk_cells:uint = 16;
    origin:Vec3 (required, native_inline);
    // Negative is solid; x changes fastest, then y, then z. Includes boundary samples.
    density:[float] (required);
}

root_type TerrainAssetData;
file_identifier "ETRN";
