include "common.fbs";
namespace engine.schema;

table ModelNodeData {
    name:string (required);
    parent:int = -1;
    position:Vec3 (required, native_inline);
    rotation:Vec3 (required, native_inline);
    scale:Vec3 (required, native_inline, native_default: "Vec3(1.0, 1.0, 1.0)");
    mesh_guid:string;
    material_guids:[string];
    source_key:string;
}

table ModelData {
    // Producers must explicitly write the current format; zero is invalid.
    schema_version:uint = 0;
    path:string (required);
    nodes:[ModelNodeData] (required);
}

root_type ModelData;
file_identifier "EMDL";
