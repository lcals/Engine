include "common.fbs";
namespace engine.schema;

enum CullMode:ubyte { back, front, none }

table MaterialParameter {
    name:string (required);
    value:MaterialValue (required);
}

table MaterialTexture {
    name:string (required);
    texture_guid:string;
    texture_path:string (required);
}

table MaterialData {
    schema_version:uint = 1;
    shader_guid:string;
    // Origin and identity are both encoded in builtin/ or project/ paths.
    type_path:string (required);
    // A builtin/ material cannot depend on a project/ shader.
    shader_path:string (required);
    parameters:[MaterialParameter] (required);
    textures:[MaterialTexture];
    // Geometric face selection, shared by color and shadow passes.
    cull_mode:CullMode = back;
}

root_type MaterialData;
file_identifier "EMAT";
