namespace engine.schema;

enum AssetKind:ubyte { source, script, scene, mesh, shader, material, texture, audio, model, skeleton, animation, font, ui }

table FileLocation {
    mount:string (required);
    path:string (required);
    offset:ulong;
    length:ulong;
}

table AssetEntry {
    guid:string (required);
    path:string (required);
    kind:AssetKind = source;
    content_hash:string (required);
    content_size:ulong;
    dependencies:[string];
    module_path:string;
    format_version:uint = 1;
    // 8-byte prefix plus FlatBuffers header, excluding the payload.
    header_size:uint;
    location:FileLocation;
}

table AssetCatalogData {
    schema_version:uint = 1;
    revision:string (required);
    target_platform:string (required);
    entries:[AssetEntry] (required);
}

root_type AssetCatalogData;
file_identifier "EASC";
