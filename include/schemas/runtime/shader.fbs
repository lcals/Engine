include "common.fbs";
namespace engine.schema;

table ShaderParameter {
    name:string (required);
    uniform_name:string (required);
    uniform_offset:ubyte = 0;
    exposed:bool = true;
    bounded:bool = false;
    minimum:double = 0;
    maximum:double = 1;
    default_value:MaterialValue (required);
}

enum ShaderTextureSource:ubyte { resource, scene_color, scene_depth, planar_reflection }

table ShaderSampler {
    name:string (required);
    uniform_name:string (required);
    stage:ubyte;
    default_texture:string (required);
    exposed:bool = true;
    source:ShaderTextureSource = resource;
}

table ShaderData {
    schema_version:uint = 1;
    // Canonical resource path: assets-relative or in the builtin:// namespace.
    path:string (required);
    vertex_code:[ubyte] (required);
    fragment_code:[ubyte] (required);
    parameters:[ShaderParameter] (required);
    samplers:[ShaderSampler];
    surface_fragment_code:[ubyte];
}

root_type ShaderData;
file_identifier "ESHD";
