include "common.fbs";
namespace engine.schema;

table ShaderParameter {
  name:string (required);
  uniform_name:string (required);
  uniform_offset:ubyte = 0;
  exposed:bool = true;
  bounded:bool = false;
  minimum:double = 0;
  maximum:double = 1;
  default_value:MaterialValue (required);
}

table ShaderData {
  schema_version:uint = 1;
  // Canonical unique resource identity, prefixed by builtin/ or project/.
  path:string (required);
  vertex_code:[ubyte] (required);
  fragment_code:[ubyte] (required);
  parameters:[ShaderParameter] (required);
}

root_type ShaderData;
file_identifier "ESHD";
