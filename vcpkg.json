{
  "name": "engine",
  "version-string": "0.1.0",
  "builtin-baseline": "8450b1326545e5e933c36d698c74df072ffca6d0",
  "dependencies": [
    "fmt",
    "nlohmann-json"
  ],
  "features": {
    "tracy": {
      "description": "Optional on-demand performance profiling client",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        }
      ]
    },
    "runtime": {
      "description": "Windows, macOS, Linux, and Android game runtime dependencies",
      "dependencies": [
        "basisu",
        "bgfx",
        {
          "name": "bgfx",
          "features": [
            "tools"
          ],
          "host": true
        },
        "flatbuffers",
        {
          "name": "flatbuffers",
          "host": true
        },
        "flecs",
        "joltphysics",
        "quill",
        {
          "name": "tbb",
          "default-features": false
        },
        "recastnavigation",
        {
          "name": "rmlui",
          "default-features": false
        },
        "sdl3",
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ],
          "platform": "android"
        }
      ]
    },
    "editor": {
      "description": "Desktop editor UI dependencies",
      "dependencies": [
        "tomlplusplus",
        {
          "name": "imgui",
          "features": [
            "docking-experimental",
            "sdl3-binding"
          ]
        }
      ]
    },
    "asset-pipeline": {
      "description": "Editor and offline asset processing dependencies",
      "dependencies": [
        "basisu",
        {
          "name": "bgfx",
          "features": [
            "tools"
          ],
          "host": true
        },
        "efsw",
        "flatbuffers",
        "meshoptimizer",
        "mikktspace",
        "sqlite3",
        "sdl3",
        "tomlplusplus"
      ]
    },
    "modeling": {
      "description": "Editor modeling plugin polygon and solid geometry dependencies",
      "dependencies": [
        "earcut-hpp",
        "manifold",
        "mikktspace"
      ]
    },
    "font-import": {
      "description": "Optional editor TrueType font import plugin",
      "dependencies": [
        "freetype"
      ]
    },
    "usd-import": {
      "description": "Optional editor USD model import plugin",
      "dependencies": [
        "usd"
      ]
    },
    "quickjs": {
      "description": "Optional lightweight QuickJS JavaScript runtime",
      "dependencies": [
        "quickjs-ng"
      ]
    },
    "destruction-authoring": {
      "description": "Optional editor Blast fracture authoring exact arithmetic",
      "dependencies": [
        "boost-multiprecision"
      ]
    }
  }
}
