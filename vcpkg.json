{
  "name": "engine",
  "version-string": "0.1.0",
  "builtin-baseline": "8450b1326545e5e933c36d698c74df072ffca6d0",
  "dependencies": [
    "fmt",
    "nlohmann-json"
  ],
  "features": {
    "ios-device-sync": {
      "description": "Desktop MCP app-container transport for paired iOS devices",
      "dependencies": [
        "libimobiledevice"
      ]
    },
    "tracy": {
      "description": "Optional on-demand performance profiling client",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        }
      ]
    },
    "runtime": {
      "description": "Windows, macOS, Linux, and Android game runtime dependencies",
      "dependencies": [
        "basisu",
        "bgfx",
        {
          "name": "bgfx",
          "features": [
            "tools"
          ],
          "host": true
        },
        "flatbuffers",
        {
          "name": "flatbuffers",
          "host": true
        },
        "flecs",
        "joltphysics",
        "libvpx",
        "quill",
        {
          "name": "tbb",
          "default-features": false
        },
        "recastnavigation",
        {
          "name": "rmlui",
          "default-features": false
        },
        "sdl3",
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ],
          "platform": "android"
        }
      ]
    },
    "editor": {
      "description": "Desktop editor UI dependencies",
      "dependencies": [
        "tomlplusplus",
        {
          "name": "imgui",
          "features": [
            "docking-experimental",
            "sdl3-binding"
          ]
        }
      ]
    },
    "asset-pipeline": {
      "description": "Editor and offline asset processing dependencies",
      "dependencies": [
        "basisu",
        {
          "name": "bgfx",
          "features": [
            "tools"
          ],
          "host": true
        },
        "efsw",
        "flatbuffers",
        "meshoptimizer",
        "mikktspace",
        "sqlite3",
        "sdl3",
        "tomlplusplus"
      ]
    },
    "modeling": {
      "description": "Editor modeling plugin polygon and solid geometry dependencies",
      "dependencies": [
        "earcut-hpp",
        "manifold",
        "mikktspace"
      ]
    },
    "font-import": {
      "description": "TrueType/OpenType support for the editor asset import plugin",
      "dependencies": [
        "freetype"
      ]
    },
    "movie-import": {
      "description": "Host FFmpeg tools for offline movie import",
      "dependencies": [
        {
          "name": "ffmpeg",
          "host": true,
          "default-features": false,
          "features": [
            "ffmpeg",
            "ffprobe",
            "vpx",
            "swresample",
            "swscale"
          ]
        }
      ]
    },
    "usd-import": {
      "description": "USD model support for the editor asset import plugin",
      "dependencies": [
        "usd"
      ]
    },
    "quickjs": {
      "description": "Optional lightweight QuickJS JavaScript runtime",
      "dependencies": [
        "quickjs-ng"
      ]
    },
    "destruction-authoring": {
      "description": "Optional editor Blast fracture authoring exact arithmetic",
      "dependencies": [
        "boost-multiprecision"
      ]
    },
    "web": {
      "description": "Host WGSL compiler for exported WebGPU runtime packages.",
      "dependencies": [
        {
          "name": "bgfx",
          "host": true,
          "default-features": false,
          "features": [
            "tools",
            "wgsl"
          ]
        },
        {
          "name": "sdl3",
          "features": [
            "emscripten-pthreads"
          ],
          "platform": "emscripten"
        }
      ]
    }
  }
}
