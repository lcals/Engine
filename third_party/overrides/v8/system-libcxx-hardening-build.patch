--- /dev/null
+++ b/config/c++/engine_system_libcxx_guard.h
@@ -0,0 +1,28 @@
+// System libc++ compatibility for the checked engine embedding configuration.
+#ifndef ENGINE_V8_SYSTEM_LIBCXX_GUARD_H_
+#define ENGINE_V8_SYSTEM_LIBCXX_GUARD_H_
+
+#include <__config>
+
+#ifndef _LIBCPP_VERSION
+#error "The checked V8 system library must be libc++"
+#endif
+#ifndef _LIBCPP_HARDENING_MODE_EXTENSIVE
+#error "V8 requires the vendor libc++ EXTENSIVE hardening implementation"
+#endif
+#if _LIBCPP_HARDENING_MODE != _LIBCPP_HARDENING_MODE_EXTENSIVE
+#error "V8 system libc++ bounds checks must remain enabled"
+#endif
+#if defined(__ANDROID__)
+#if _LIBCPP_VERSION != 210000
+#error "Revalidate the Android libc++ version before enabling V8 sandbox"
+#endif
+#elif defined(__APPLE__)
+#if _LIBCPP_VERSION != 220106
+#error "Revalidate the macOS libc++ version before enabling V8 sandbox"
+#endif
+#else
+#error "Checked V8 system libc++ is validated only on macOS and Android"
+#endif
+
+#endif  // ENGINE_V8_SYSTEM_LIBCXX_GUARD_H_
