--- a/toolchain/apple/linker_driver.py
+++ b/toolchain/apple/linker_driver.py
@@ -174,6 +174,23 @@
                 "[linker-args]..."
             )
 
+        # The downloaded Clang package omits libLTO, but its driver still
+        # supplies that path to Apple's linker. Select Xcode's matching library
+        # explicitly when using the system linker; retain fatal linker warnings.
+        if (sys.platform == 'darwin' and not any(
+                arg.startswith(('-fuse-ld=', '-Wl,-lto_library'))
+                for arg in self._compiler_driver_args)):
+            compiler_dir = os.path.dirname(os.path.abspath(self._driver_path))
+            bundled_lto = os.path.join(compiler_dir, '..', 'lib', 'libLTO.dylib')
+            if not os.path.isfile(bundled_lto):
+                xcode_clang = subprocess.check_output(
+                    ['xcrun', '--find', 'clang'], text=True).strip()
+                xcode_lto = os.path.normpath(os.path.join(
+                    os.path.dirname(xcode_clang), '..', 'lib', 'libLTO.dylib'))
+                if not os.path.isfile(xcode_lto):
+                    raise RuntimeError('Xcode libLTO is unavailable: ' + xcode_lto)
+                self._compiler_driver_args.append('-Wl,-lto_library,' + xcode_lto)
+
         if self._get_linker_output() is None:
             raise ValueError(
                 'Could not find path to linker output (-o or --output)'
--- a/toolchain/apple/toolchain.gni
+++ b/toolchain/apple/toolchain.gni
@@ -515,7 +515,7 @@
 
         rspfile_content =
             "$rustc_common_args {{rustdeps}} {{externs}} SOURCES {{sources}}"
-        command = "$rustc_wrapper --depfile=$depfile --emit=dep-info=$depfile,link -o $dllname -- -Clinker=\"${_cxx}\" {{source}} LDFLAGS $bin_flag {{ldflags}} RUSTENV {{rustenv}}"
+        command = "$linker_driver_env $rustc_wrapper --depfile=$depfile --emit=dep-info=$depfile,link -o $dllname -- -Clinker=\"$linker_driver\" {{source}} LDFLAGS $linker_driver_args $bin_flag {{ldflags}} -Wl,-no_warn_duplicate_libraries RUSTENV {{rustenv}}"
         rust_sysroot = rust_sysroot_relative
         inputs = rustc_wrapper_inputs
       }
