+		// Reserve before binding: submitted draws keep their old Metal buffer, while
+		// the current draw starts a fresh segment when the frame exhausts capacity.
+		bool reserveUniformBuffer(uint32_t _vertexSize, uint32_t _vertexAlignment, uint32_t _fragmentSize, uint32_t _fragmentAlignment)
+		{
+			const uint32_t vertexAlignment   = bx::uint32_max(1, _vertexAlignment);
+			const uint32_t fragmentAlignment = bx::uint32_max(1, _fragmentAlignment);
+			uint64_t vertexOffset = 0 != _vertexSize
+				? bx::alignUp(uint64_t(m_uniformBufferVertexOffset), vertexAlignment)
+				: m_uniformBufferVertexOffset;
+			uint64_t fragmentOffset = vertexOffset + _vertexSize;
+			if (0 != _fragmentSize)
+			{
+				fragmentOffset = bx::alignUp(fragmentOffset, fragmentAlignment);
+			}
+			uint64_t end = fragmentOffset + _fragmentSize;
+
+			if (end > m_uniformBuffer.length() )
+			{
+				vertexOffset   = 0;
+				fragmentOffset = 0 != _fragmentSize
+					? bx::alignUp(uint64_t(_vertexSize), fragmentAlignment)
+					: _vertexSize;
+				end = fragmentOffset + _fragmentSize;
+				if (end > UNIFORM_BUFFER_MAX_SIZE)
+				{
+					BGFX_FATAL(false, Fatal::InvalidShader, "Metal uniform block exceeds maximum segment capacity.");
+					return false;
+				}
+
+				const uint64_t capacity = bx::min<uint64_t>(UNIFORM_BUFFER_MAX_SIZE,
+					bx::max<uint64_t>(UNIFORM_BUFFER_SIZE,
+						bx::max<uint64_t>(uint64_t(m_uniformBuffer.length() ) * 2, end) ) );
+				Buffer replacement = m_device.newBufferWithLength(uint32_t(capacity), 0);
+				if (NULL == replacement || NULL == replacement.contents() )
+				{
+					MTL_RELEASE(replacement);
+					BGFX_FATAL(false, Fatal::UnableToInitialize, "Unable to allocate Metal uniform buffer segment.");
+					return false;
+				}
+
+				// Use the existing GPU completion queue, not an immediate release: earlier
+				// draw/compute commands still reference this frame's previous segment.
+				if (NULL != m_uniformBuffer)
+				{
+					m_cmd.release(m_uniformBuffer);
+				}
+				const uint8_t slot = (m_bufferIndex + BGFX_CONFIG_MAX_FRAME_LATENCY - 1) % BGFX_CONFIG_MAX_FRAME_LATENCY;
+				m_uniformBuffers[slot] = replacement;
+				m_uniformBuffer = replacement;
+			}
+
+			if (0 != end && NULL == m_uniformBuffer.contents() )
+			{
+				BGFX_FATAL(false, Fatal::UnableToInitialize, "Metal uniform buffer is not CPU accessible.");
+				return false;
+			}
+			m_uniformBufferVertexOffset   = uint32_t(vertexOffset);
+			m_uniformBufferFragmentOffset = uint32_t(fragmentOffset);
+			m_uniformBufferVertexSize     = _vertexSize;
+			m_uniformBufferFragmentSize   = _fragmentSize;
+			return true;
+		}
