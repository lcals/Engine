--- a/cmake/macros/Public.cmake
+++ b/cmake/macros/Public.cmake
@@ -328,6 +328,13 @@ function(pxr_library NAME)
         endforeach()
     endif()
 
+    # Static applications retain plugin registration objects at link time.
+    # Leave the type implicit so the library participates in the normal static
+    # dependency/whole-archive handling instead of being skipped as a DSO.
+    if(args_TYPE STREQUAL "PLUGIN" AND NOT BUILD_SHARED_LIBS AND NOT PXR_BUILD_MONOLITHIC)
+        set(args_TYPE "")
+    endif()
+
     # Collect libraries.
     if(NOT args_TYPE STREQUAL "PLUGIN")
         get_property(help CACHE PXR_ALL_LIBS PROPERTY HELPSTRING)
--- a/pxr/pxrConfig.cmake.in
