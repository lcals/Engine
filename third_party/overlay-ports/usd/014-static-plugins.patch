 if(NOT @BUILD_SHARED_LIBS@)
     if(WIN32)
         list(APPEND PXR_LIBRARIES Shlwapi.lib)
         list(APPEND PXR_LIBRARIES Dbghelp.lib)
+        if(MSVC)
+            set(_pxr_explicit_static "@PXR_STATIC_LIBS@")
+            foreach(_pxr_library IN LISTS libs)
+                if(NOT _pxr_library IN_LIST _pxr_explicit_static)
+                    target_link_options(${_pxr_library} INTERFACE
