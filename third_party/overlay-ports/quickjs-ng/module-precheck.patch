+/* Link the complete module graph without evaluating module bodies. */
+int JS_InstantiateModule(JSContext *ctx, JSValueConst obj)
+{
+    JSModuleDef *m;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_MODULE) {
+        JS_ThrowTypeError(ctx, "module expected");
+        return -1;
+    }
+    m = JS_VALUE_GET_PTR(obj);
+    if (JS_ResolveModule(ctx, obj) < 0 ||
+        js_create_module_function(ctx, m) < 0)
+        return -1;
+    return js_link_module(ctx, m);
+}
+
+/* Inspect parser metadata, including transitive and cyclic dependencies.
+   Do not change module status or execute code to discover top-level await. */
+int JS_IsModuleGraphAsync(JSContext *ctx, JSValueConst obj)
+{
+    JSModuleDef **modules = NULL;
+    JSModuleDef *m, *dependency;
+    int count = 0, capacity = 0, index, i, j, result = 0;
+
+    if (JS_VALUE_GET_TAG(obj) != JS_TAG_MODULE) {
+        JS_ThrowTypeError(ctx, "module expected");
+        return -1;
+    }
+    if (JS_ResolveModule(ctx, obj) < 0)
+        return -1;
+    if (js_resize_array(ctx, (void **)&modules, sizeof(*modules), &capacity, 1))
+        return -1;
+    modules[count++] = JS_VALUE_GET_PTR(obj);
+    for (index = 0; index < count; index++) {
+        m = modules[index];
+        if (m->has_tla) {
+            result = 1;
+            break;
+        }
+        for (i = 0; i < m->req_module_entries_count; i++) {
+            dependency = m->req_module_entries[i].module;
+            for (j = 0; j < count; j++) {
+                if (modules[j] == dependency)
+                    break;
+            }
+            if (j != count)
+                continue;
+            if (count == INT_MAX) {
+                JS_ThrowInternalError(ctx, "module graph is too large");
+                result = -1;
+                goto done;
+            }
+            if (js_resize_array(ctx, (void **)&modules, sizeof(*modules),
+                                &capacity, count + 1)) {
+                result = -1;
+                goto done;
+            }
+            modules[count++] = dependency;
+        }
+    }
+ done:
+    js_free(ctx, modules);
+    return result;
+}
