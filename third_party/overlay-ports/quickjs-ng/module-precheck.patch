+/* Loader callbacks accept NUL-terminated paths. Reject embedded NUL before
+   losing the atom's length, including names from import and re-export. */
+static const char *js_module_atom_to_cstring(JSContext *ctx, JSAtom atom)
+{
+    JSValue string;
+    const char *name;
+    size_t length;
+
+    string = JS_AtomToString(ctx, atom);
+    if (JS_IsException(string))
+        return NULL;
+    name = JS_ToCStringLen(ctx, &length, string);
+    JS_FreeValue(ctx, string);
+    if (name && memchr(name, '\0', length)) {
+        JS_FreeCString(ctx, name);
+        JS_ThrowReferenceError(ctx, "module path contains a NUL character");
+        return NULL;
+    }
+    return name;
+}
