+void lmSubmitPixels(lm_context *ctx, const float *rgba, int width, int height)
+{
+    assert(width == ctx->cpuViewport[2] && height == ctx->cpuViewport[3]);
+    const unsigned int stride = 3 * ctx->hemisphere.size;
+    for (int y = 0; y < height; ++y)
+    {
+        const int sy = ctx->cpuViewport[1] + height - 1 - y;
+        for (int x = 0; x < width; ++x)
+        {
+            const int sx = ctx->cpuViewport[0] + x;
+            const float *weights = ctx->cpuWeights + 2 * (sy * stride + sx);
+            const float *pixel = rgba + 4 * (y * width + x);
+            for (int c = 0; c < 3; ++c)
+                ctx->cpuSum[c] += pixel[c] * weights[0] * 6.2831853071795864769;
+            ctx->cpuSum[3] += pixel[3] * weights[1];
+        }
+    }
+}
