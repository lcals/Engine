shader = "00000000-0000-4000-8000-000000000001"

[[parameters]]
name = "baseColor"
type = "v4"
value = [0.0, 0.0, 0.0, 1.0]

# Preserve the authored light-source RGB as linear emission.
[[parameters]]
name = "emissionColor"
type = "v3"
value = [1, 0.8, 0.48]

[[parameters]]
name = "roughness"
type = "float"
value = 0.4
