<rml>
<head>
<title>Engine Showcase</title>
<style>
div, h1, h2, body { display: block; }
body { margin: 0; width: 100%; height: 100%; background-color: #0e1726; color: #eaf1fa; font-family: body; font-size: 17px; }
scrollbarvertical { width: 12px; background-color: #101d2d; }
scrollbarvertical slidertrack { width: 12px; }
scrollbarvertical sliderbar { width: 8px; margin: 2px; min-height: 24px; background-color: #375973; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { display: none; }
.page { margin: 44px 56px; }
.eyebrow { color: #73dfc3; font-size: 13px; letter-spacing: 3px; margin-bottom: 17px; }
h1 { font-family: heading; font-size: 52px; font-weight: normal; margin: 0 0 12px 0; }
.lead { color: #a4b5ca; font-size: 19px; margin-bottom: 34px; }
.cards { display: flex; flex-wrap: wrap; gap: 18px; }
.card { width: 45%; background-color: #17263b; border-width: 1px; border-color: #2b3d54; padding: 22px; box-sizing: border-box; margin: 0 18px 18px 0; }
.number { color: #73dfc3; font-size: 13px; letter-spacing: 2px; margin-bottom: 12px; }
h2 { font-family: heading; font-size: 27px; font-weight: normal; margin: 0 0 8px 0; }
.description { color: #a4b5ca; font-size: 16px; margin-bottom: 18px; }
button { tab-index: auto; display: block; box-sizing: border-box; width: 100%; text-align: left; padding: 11px 14px; color: #eaf1fa; background-color: #263b53; border-width: 0; font-family: body; font-size: 16px; }
button:hover { background-color: #375973; color: #ffffff; }
button:focus { background-color: #375973; border-width: 1px; border-color: #73dfc3; }
button:active { background-color: #73dfc3; color: #102a2c; }
#back-menu { display: none; position: absolute; top: 24px; left: 24px; width: 190px; pointer-events: auto; }
#launcher-root.in-world { background-color: #00000000; pointer-events: none; overflow-y: hidden; }
#launcher-root.in-world #launcher-page { display: none; }
#launcher-root.in-world #back-menu { display: block; }
.footer { color: #7d94af; font-size: 14px; margin-top: 14px; }
@media (max-width: 700px) { scrollbarvertical { width: 12px; background-color: #101d2d; }
scrollbarvertical slidertrack { width: 12px; }
scrollbarvertical sliderbar { width: 8px; margin: 2px; min-height: 24px; background-color: #375973; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { display: none; }
.page { margin: 24px; } h1 { font-family: heading; font-size: 34px; } .card { width: 100%; } .cards { display: block; } body { overflow-y: auto; } }
</style>
</head>
<body id="launcher-root">
<button id="back-menu">Back to scenes</button>
<div id="launcher-page" class="page">
    <div class="eyebrow">ENGINE / SCENE COLLECTION</div>
    <h1>Choose your next scene.</h1>
    <div class="lead">One project. Four worlds to explore.</div>
    <div class="cards">
        <div class="card"><div class="number">01 / MATERIAL STUDY</div><h2>PBR essentials</h2><div class="description">A rotating cube. Light, surface and reflection.</div><button id="scene-cube">Open PBR cube</button></div>
        <div class="card"><div class="number">02 / INTERIOR</div><h2>Modern apartment</h2><div class="description">A furnished home with warm, layered lighting.</div><button id="scene-apartment">Open apartment</button></div>
        <div class="card"><div class="number">03 / CHARACTER LAB</div><h2>Animation courtyard</h2><div class="description">Skinned animation, physical movement and space.</div><button id="scene-courtyard">Open courtyard</button></div>
        <div class="card"><div class="number">04 / TYPOGRAPHY</div><h2>Letters in space</h2><div class="description">The same vector font, rendered as 3D scene text.</div><button id="scene-gallery">Open font gallery</button></div>
    </div>
    <div id="launcher-status" class="footer">Open a scene. Mouse, touch and keyboard share the same controller.</div>
</div>
</body>
</rml>
